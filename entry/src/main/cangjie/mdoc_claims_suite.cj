@Test
public class DocMetadataIssuerDisplayNameTest {

    /* getIssuerDisplayName picks the locale-matching issuerDisplay entry. */
    @TestCase
    func issuerDisplayNameMatchesLocale(): Unit {
        let issuerDisplays = ArrayList<DisplayMetadata>()
        issuerDisplays.add(DisplayMetadata(Some("Test Issuer"), Some("en"), None, None, None, None, None))
        issuerDisplays.add(DisplayMetadata(Some("测试签发方"), Some("zh"), None, None, None, None, None))
        let dm = DocMetadata(
            "https://issuer.example.com",
            "org.iso.18013.5.1.mDL",
            "org.iso.18013.5.1.mDL",
            None,
            Some(issuerDisplays),
            None,
            None
        )
        @Assert(dm.getIssuerDisplayName(Some("zh")), Some("测试签发方"))
        @Assert(dm.getIssuerDisplayName(Some("en")), Some("Test Issuer"))
    }

    /* getIssuerDisplayName returns None when no issuerDisplay is present. */
    @TestCase
    func issuerDisplayNameNoneWhenAbsent(): Unit {
        let dm = DocMetadata(
            "https://issuer.example.com",
            "cfg",
            "doctype",
            None,
            None,
            None,
            None
        )
        @Assert(dm.getIssuerDisplayName(Some("en")).isNone())
    }
}

@Test
public class DocDataValueStringReprTest {

    /* stringRepr renders each leaf variant in human-readable form. */
    @TestCase
    func stringReprLeafVariants(): Unit {
        @Assert(DocDataValue.StringVal("hello").stringRepr(), "hello")
        @Assert(DocDataValue.IntVal(42).stringRepr(), "42")
        @Assert(DocDataValue.BoolVal(true).stringRepr(), "true")
        @Assert(DocDataValue.BoolVal(false).stringRepr(), "false")
        @Assert(DocDataValue.DateVal("2024-01-01").stringRepr(), "2024-01-01")
        @Assert(DocDataValue.NullVal.stringRepr(), "")
    }

    /* stringRepr renders containers/bytes with descriptive placeholders. */
    @TestCase
    func stringReprContainerVariants(): Unit {
        let threeBytes: Array<UInt8> = [0x01u8, 0x02u8, 0x03u8]
        @Assert(DocDataValue.BytesVal(threeBytes).stringRepr(), "<bytes:3>")
        @Assert(DocDataValue.MapEntries(ArrayList<(String, DocDataValue)>()).stringRepr(), "<map>")
        @Assert(DocDataValue.ArrayEntries(ArrayList<DocDataValue>()).stringRepr(), "<array>")
    }
}

@Test
public class DocClaimOrderTest {

    /* DocClaim.order stores the supplied display order. */
    @TestCase
    func docClaimOrderField(): Unit {
        let path = ArrayList<String>()
        path.add("ns")
        path.add("field")
        let claim = DocClaim(
            "field",
            path,
            None,
            DocDataValue.StringVal("v"),
            "v",
            false,
            Int64(7),
            Some("ns"),
            None
        )
        @Assert(claim.order, Int64(7))
    }
}
