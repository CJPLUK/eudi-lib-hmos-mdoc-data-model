@Test
public class DocDataFormatTest {

    @TestCase
    func rawValueRoundTrip(): Unit {
        @Assert(DocDataFormat.Cbor.rawValue(), "cbor")
        @Assert(DocDataFormat.Sdjwt.rawValue(), "sjwt")
        @Assert(DocDataFormat.Cbor.description(), "mso_mdoc")
        @Assert(DocDataFormat.Sdjwt.description(), "vc+sd-jwt")
    }

    @TestCase
    func fromRawValid(): Unit {
        match (DocDataFormat.fromRaw("cbor")) {
            case Some(DocDataFormat.Cbor) => @Assert(true)
            case _                        => @Assert(false)
        }
        match (DocDataFormat.fromRaw("sjwt")) {
            case Some(DocDataFormat.Sdjwt) => @Assert(true)
            case _                         => @Assert(false)
        }
    }

    @TestCase
    func fromRawInvalid(): Unit {
        match (DocDataFormat.fromRaw("unknown")) {
            case None => @Assert(true)
            case _    => @Assert(false)
        }
    }
}

@Test
public class DisplayMetadataTest {

    @TestCase
    func jsonRoundTrip(): Unit {
        let logo = LogoMetadata(Some("https://example.com/logo.png"), Some("Example logo"))
        let dm = DisplayMetadata(
            Some("Example Wallet"),
            Some("en"),
            Some(logo),
            Some("A test wallet"),
            Some("#FFFFFF"),
            Some("#000000"),
            Some("https://example.com/bg.png")
        )
        let json = dm.toJson()
        let rt = DisplayMetadata.fromJson(json)
        match (rt) {
            case Some(d) =>
                @Assert(d.name, Some("Example Wallet"))
                @Assert(d.localeIdentifier, Some("en"))
                @Assert(d.backgroundColor, Some("#FFFFFF"))
                match (d.logo) {
                    case Some(l) => @Assert(l.urlString, Some("https://example.com/logo.png"))
                    case None    => @Assert(false)
                }
            case None => @Assert(false)
        }
    }

    @TestCase
    func jsonRoundTripNonAsciiName(): Unit {
        /* non-ASCII claim value — covers the "含非 ASCII claim 值往返" requirement */
        let dm = DisplayMetadata(
            Some("身份证"),
            Some("zh-CN"),
            None,
            None,
            None,
            None,
            None
        )
        let json = dm.toJson()
        let rt = DisplayMetadata.fromJson(json)
        match (rt) {
            case Some(d) =>
                @Assert(d.name, Some("身份证"))
                @Assert(d.localeIdentifier, Some("zh-CN"))
            case None => @Assert(false)
        }
    }

    @TestCase
    func matchesLocaleNone(): Unit {
        let dm = DisplayMetadata(Some("en"), Some("en"), None, None, None, None, None)
        @Assert(dm.matchesLocale(None))
    }

    @TestCase
    func getDisplayNamePicksFirst(): Unit {
        let displays = ArrayList<DisplayMetadata>()
        displays.add(DisplayMetadata(Some("English"), Some("en"), None, None, None, None, None))
        displays.add(DisplayMetadata(Some("中文"), Some("zh"), None, None, None, None, None))
        match (getDisplayName(displays, Some("zh"))) {
            case Some(n) => @Assert(n, "中文")
            case None    => @Assert(false)
        }
    }
}

@Test
public class DocMetadataTest {

    @TestCase
    func jsonRoundTrip(): Unit {
        let dm = DocMetadata(
            "https://issuer.example.com",
            "org.iso.18013.5.1.mDL",
            "org.iso.18013.5.1.mDL",
            None,
            None,
            None,
            Some("dpop-key-123")
        )
        let jsonStr = dm.toJsonString()
        let rt = DocMetadata.fromJsonString(jsonStr)
        match (rt) {
            case Some(parsed) =>
                @Assert(parsed.credentialIssuerIdentifier, "https://issuer.example.com")
                @Assert(parsed.configurationIdentifier, "org.iso.18013.5.1.mDL")
                @Assert(parsed.docType, "org.iso.18013.5.1.mDL")
                @Assert(parsed.dpopKeyId, Some("dpop-key-123"))
            case None => @Assert(false)
        }
    }

    @TestCase
    func jsonRoundTripWithDisplays(): Unit {
        let displays = ArrayList<DisplayMetadata>()
        displays.add(DisplayMetadata(Some("mDL"), Some("en"), None, None, None, None, None))
        /* non-ASCII display name */
        displays.add(DisplayMetadata(Some("移动驾照"), Some("zh"), None, None, None, None, None))
        let dm = DocMetadata(
            "https://issuer.example.com",
            "org.iso.18013.5.1.mDL",
            "org.iso.18013.5.1.mDL",
            Some(displays),
            None,
            None,
            None
        )
        let rt = DocMetadata.fromJsonString(dm.toJsonString())
        match (rt) {
            case Some(parsed) =>
                match (parsed.display) {
                    case Some(ds) =>
                        @Assert(ds.size, Int64(2))
                        @Assert(ds[0].name, Some("mDL"))
                        @Assert(ds[1].name, Some("移动驾照"))
                    case None => @Assert(false)
                }
            case None => @Assert(false)
        }
    }

    @TestCase
    func fromInvalidJsonReturnsNone(): Unit {
        match (DocMetadata.fromJsonString("not valid json")) {
            case None => @Assert(true)
            case _    => @Assert(false)
        }
    }

    @TestCase
    func fromMissingRequiredFieldReturnsNone(): Unit {
        /* missing docType field */
        let json = "{\"credentialIssuerIdentifier\":\"x\",\"configurationIdentifier\":\"y\"}"
        match (DocMetadata.fromJsonString(json)) {
            case None => @Assert(true)
            case _    => @Assert(false)
        }
    }
}

@Test
public class DocDataValueTest {

    @TestCase
    func stringCborRoundTrip(): Unit {
        let dv = DocDataValue.StringVal("hello mDL")
        let cbor = dv.toCbor()
        let rt = DocDataValue.fromCbor(cbor)
        match (rt) {
            case DocDataValue.StringVal(s) => @Assert(s, "hello mDL")
            case _                         => @Assert(false)
        }
    }

    @TestCase
    func nonAsciiStringCborRoundTrip(): Unit {
        /* non-ASCII claim value — done_when 1 requirement */
        let dv = DocDataValue.StringVal("张三 (Zhāng Sān)")
        let cbor = dv.toCbor()
        let rt = DocDataValue.fromCbor(cbor)
        match (rt) {
            case DocDataValue.StringVal(s) => @Assert(s, "张三 (Zhāng Sān)")
            case _                         => @Assert(false)
        }
    }

    @TestCase
    func intPositiveCborRoundTrip(): Unit {
        let dv = DocDataValue.IntVal(42)
        let rt = DocDataValue.fromCbor(dv.toCbor())
        match (rt) {
            case DocDataValue.IntVal(n) => @Assert(n, Int64(42))
            case _                      => @Assert(false)
        }
    }

    @TestCase
    func intNegativeCborRoundTrip(): Unit {
        let dv = DocDataValue.IntVal(-7)
        let rt = DocDataValue.fromCbor(dv.toCbor())
        match (rt) {
            case DocDataValue.IntVal(n) => @Assert(n, Int64(-7))
            case _                      => @Assert(false)
        }
    }

    @TestCase
    func boolCborRoundTrip(): Unit {
        let t = DocDataValue.BoolVal(true)
        let f = DocDataValue.BoolVal(false)
        match (DocDataValue.fromCbor(t.toCbor())) {
            case DocDataValue.BoolVal(b) => @Assert(b)
            case _                       => @Assert(false)
        }
        match (DocDataValue.fromCbor(f.toCbor())) {
            case DocDataValue.BoolVal(b) => @Assert(!b)
            case _                       => @Assert(false)
        }
    }

    @TestCase
    func bytesCborRoundTrip(): Unit {
        let bytes: Array<UInt8> = [0xDE, 0xAD, 0xBE, 0xEF]
        let dv = DocDataValue.BytesVal(bytes)
        let rt = DocDataValue.fromCbor(dv.toCbor())
        match (rt) {
            case DocDataValue.BytesVal(b) =>
                @Assert(b.size, Int64(4))
                @Assert(b[0], UInt8(0xDE))
                @Assert(b[3], UInt8(0xEF))
            case _ => @Assert(false)
        }
    }

    @TestCase
    func mapEntriesCborRoundTrip(): Unit {
        let entries = ArrayList<(String, DocDataValue)>()
        entries.add(("name", DocDataValue.StringVal("Alice")))
        entries.add(("age",  DocDataValue.IntVal(30)))
        let dv = DocDataValue.MapEntries(entries)
        let cbor = dv.toCbor()
        let rt = DocDataValue.fromCbor(cbor)
        match (rt) {
            case DocDataValue.MapEntries(e) =>
                @Assert(e.size, Int64(2))
            case _ => @Assert(false)
        }
    }
}

@Test
public class DocClaimTest {

    @TestCase
    func constructAndId(): Unit {
        let path = ArrayList<String>()
        path.add("org.iso.18013.5.1")
        path.add("family_name")
        let claim = DocClaim(
            "family_name",
            path,
            Some("Family Name"),
            DocDataValue.StringVal("Mustermann"),
            "Mustermann",
            false,
            Int64(0),
            Some("org.iso.18013.5.1"),
            None
        )
        @Assert(claim.name, "family_name")
        @Assert(claim.stringValue, "Mustermann")
        @Assert(claim.id(), "org.iso.18013.5.1.family_name")
    }

    @TestCase
    func cborRoundTripSimpleString(): Unit {
        let path = ArrayList<String>()
        path.add("ns")
        path.add("given_name")
        let claim = DocClaim(
            "given_name",
            path,
            None,
            DocDataValue.StringVal("Max"),
            "Max",
            false,
            Int64(1),
            Some("ns"),
            None
        )
        let cbor = claim.toCbor()
        let rt = DocDataValue.fromCbor(cbor)
        match (rt) {
            case DocDataValue.StringVal(s) => @Assert(s, "Max")
            case _                          => @Assert(false)
        }
    }

    @TestCase
    func cborRoundTripNonAscii(): Unit {
        /* non-ASCII claim value round-trip — required by done_when 1 */
        let path = ArrayList<String>()
        path.add("ns")
        path.add("family_name")
        let claim = DocClaim(
            "family_name",
            path,
            None,
            DocDataValue.StringVal("李明"),
            "李明",
            false,
            Int64(0),
            Some("ns"),
            None
        )
        let cbor = claim.toCbor()
        let bytes = cbor.encode()
        let decoded = decodeCbor(bytes)
        let rtDv = DocDataValue.fromCbor(decoded)
        match (rtDv) {
            case DocDataValue.StringVal(s) => @Assert(s, "李明")
            case _                          => @Assert(false)
        }
    }

    @TestCase
    func fromCborBuildsTree(): Unit {
        /* Build a map CBOR value and verify DocClaim.fromCbor creates children */
        let pairs = ArrayList<(CborValue, CborValue)>()
        pairs.add((CborValue.TextStringVal("street"),
                   CborValue.TextStringVal("Main St 1")))
        pairs.add((CborValue.TextStringVal("city"),
                   CborValue.TextStringVal("Berlin")))
        let mapCbor = CborValue.MapVal(pairs)

        let path = ArrayList<String>()
        path.add("ns")
        path.add("address")
        let node = DocClaim.fromCbor(
            "address", path, mapCbor, "ns", Int64(5),
            None, None
        )
        match (node.children) {
            case Some(ch) => @Assert(ch.size, Int64(2))
            case None      => @Assert(false)
        }
    }

    @TestCase
    func addChildMutation(): Unit {
        let path = ArrayList<String>()
        let parent = DocClaim("parent", path, None,
                              DocDataValue.NullVal, "", false, Int64(0), None, None)
        let childPath = ArrayList<String>()
        childPath.add("c")
        let child = DocClaim("c", childPath, None,
                             DocDataValue.StringVal("x"), "x", false, Int64(0), None, None)
        parent.addChild(child)
        match (parent.children) {
            case Some(ch) => @Assert(ch.size, Int64(1))
            case None      => @Assert(false)
        }
    }
}

/* ================================================================
 * Test 2 — DocClaimsDecodable interface + factory dispatch by docType
 * done_when: DocClaimsDecodable 协议与工厂可按 docType 分发
 * ================================================================ */

/** Minimal DocClaimsDecodable implementation for test. */
class TestDocument <: DocClaimsDecodable {
    let docId: String
    let docType_: String
    let claims_: ArrayList<DocClaim>
    let format_: DocDataFormat

    public init(id: String, docType: String, claims: ArrayList<DocClaim>,
                format: DocDataFormat) {
        this.docId = id
        this.docType_ = docType
        this.claims_ = claims
        this.format_ = format
    }

    public func getId(): String { return this.docId }
    public func getDocType(): String { return this.docType_ }
    public func getDocClaims(): ArrayList<DocClaim> { return this.claims_ }
    public func getDocDataFormat(): DocDataFormat { return this.format_ }
    public func getDisplayName(): ?String { return Some("Test Document") }
    public func getDisplay(): ?ArrayList<DisplayMetadata> { return None }
    public func getIssuerDisplay(): ?ArrayList<DisplayMetadata> { return None }
}

/** Minimal factory for test docType. */
class TestFactory <: DocClaimsDecodableFactory {
    let handledDocType: String

    public init(dt: String) {
        this.handledDocType = dt
    }

    public func make(
        docType: String,
        claims: HashMap<String, HashMap<String, CborValue>>,
        metadata: ?DocMetadata
    ): ?DocClaimsDecodable {
        if (docType != this.handledDocType) {
            return None
        }
        let docClaims = ArrayList<DocClaim>()
        let doc = TestDocument("test-id-001", docType, docClaims, DocDataFormat.Cbor)
        return Some(doc)
    }
}

@Test
public class DocClaimsDecodableRegistryTest {

    @TestCase
    func registerAndDispatch(): Unit {
        let mdlDocType = "org.iso.18013.5.1.mDL.test"
        let factory = TestFactory(mdlDocType)
        DocClaimsDecodableRegistry.register(mdlDocType, factory)
        @Assert(DocClaimsDecodableRegistry.isRegistered(mdlDocType))

        let claims = HashMap<String, HashMap<String, CborValue>>()
        let result = DocClaimsDecodableRegistry.make(mdlDocType, claims, None)
        match (result) {
            case Some(doc) =>
                @Assert(doc.getDocType(), mdlDocType)
                @Assert(doc.getId(), "test-id-001")
                match (doc.getDocDataFormat()) {
                    case DocDataFormat.Cbor => @Assert(true)
                    case _                  => @Assert(false)
                }
            case None => @Assert(false)
        }

        DocClaimsDecodableRegistry.unregister(mdlDocType)
        @Assert(!DocClaimsDecodableRegistry.isRegistered(mdlDocType))
    }

    @TestCase
    func unregisteredDocTypeReturnsNone(): Unit {
        let claims = HashMap<String, HashMap<String, CborValue>>()
        let result = DocClaimsDecodableRegistry.make("unknown.doctype.xyz", claims, None)
        match (result) {
            case None => @Assert(true)
            case _    => @Assert(false)
        }
    }

    @TestCase
    func replaceFactoryForSameDocType(): Unit {
        let dt = "org.test.replace"
        DocClaimsDecodableRegistry.register(dt, TestFactory(dt))
        DocClaimsDecodableRegistry.register(dt, TestFactory(dt))
        @Assert(DocClaimsDecodableRegistry.isRegistered(dt))
        DocClaimsDecodableRegistry.unregister(dt)
    }

    @TestCase
    func factoryDoesNotHandleMismatch(): Unit {
        let f = TestFactory("org.iso.18013.5.1.mDL")
        let claims = HashMap<String, HashMap<String, CborValue>>()
        match (f.make("other.doctype", claims, None)) {
            case None => @Assert(true)
            case _    => @Assert(false)
        }
    }
}

