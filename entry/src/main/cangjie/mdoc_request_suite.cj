/* ------------------------------------------------------------------ */
/* Helper: build a minimal RequestDataElements                         */
/* ------------------------------------------------------------------ */

func makeRde(elements: Array<(String, Bool)>): RequestDataElements {
    let map = HashMap<String, Bool>()
    for ((k, v) in elements) {
        map[k] = v
    }
    return RequestDataElements(map)
}

/* Helper: build a ReaderAuth with a synthetic x5chain cert */
func makeSyntheticReaderAuth(): CborValue {
    // Build a fake unprotected header map with x5chain (key = 33)
    let certBytes: Array<UInt8> = [0x30, 0x82, 0x01, 0x00, 0xDE, 0xAD]
    let uphPairs = ArrayList<(CborValue, CborValue)>()
    uphPairs.add((CborValue.UInt64Val(33), CborValue.ByteStringVal(certBytes)))
    let uphMap = CborValue.MapVal(uphPairs)
    let uphBytes = uphMap.encode()
    // Build a protected header (alg = ES256 = -7)
    let ph = CoseHeader.build(VerifyAlgorithm.Es256.coseValue(), true, None)
    // Build unprotected header as CoseHeader
    let uphHeader = CoseHeader(None, None, Some(uphBytes))
    let payload: Array<UInt8> = [0x01, 0x02, 0x03]
    let sig: Array<UInt8> = [0xAA, 0xBB, 0xCC, 0xDD]
    let cose = CoseSign1(ph, Some(uphHeader), Some(payload), sig)
    return cose.toCbor()  // untagged 4-element array
}

/* ------------------------------------------------------------------ */
/* Test class — done_when 1: CBOR round-trip                           */
/* ------------------------------------------------------------------ */

@Test
public class MdocRequestRoundTripTest {

    /*
     * done_when 1a: RequestDataElements encode/decode round-trip.
     */
    @TestCase
    func requestDataElementsRoundTrip(): Unit {
        let rde = makeRde([("family_name", true), ("document_number", false)])
        let cbor = rde.toCbor()
        let decoded = RequestDataElements.fromCbor(cbor)
        match (decoded.dataElements.get("family_name")) {
            case Some(v) => @Assert(v == true)
            case None => @Assert(false)
        }
        match (decoded.dataElements.get("document_number")) {
            case Some(v) => @Assert(v == false)
            case None => @Assert(false)
        }
        @Assert(decoded.dataElements.size == 2)
    }

    /*
     * done_when 1b: RequestNameSpaces with two namespaces encode/decode round-trip.
     */
    @TestCase
    func requestNameSpacesTwoNamespacesRoundTrip(): Unit {
        let rde1 = makeRde([("family_name", true), ("portrait", false)])
        let rde2 = makeRde([("birth_date", true)])
        let nsMap = HashMap<String, RequestDataElements>()
        nsMap["org.iso.18013.5.1"] = rde1
        nsMap["org.iso.18013.5.1.aamva"] = rde2
        let rns = RequestNameSpaces(nsMap)
        let cbor = rns.toCbor()
        let decoded = RequestNameSpaces.fromCbor(cbor)
        @Assert(decoded.nameSpaces.size == 2)
        match (decoded.get("org.iso.18013.5.1")) {
            case Some(rdeDecoded) =>
                match (rdeDecoded.dataElements.get("family_name")) {
                    case Some(v) => @Assert(v == true)
                    case None => @Assert(false)
                }
            case None => @Assert(false)
        }
        match (decoded.get("org.iso.18013.5.1.aamva")) {
            case Some(rdeDecoded) =>
                match (rdeDecoded.dataElements.get("birth_date")) {
                    case Some(v) => @Assert(v == true)
                    case None => @Assert(false)
                }
            case None => @Assert(false)
        }
    }

    /*
     * done_when 1c: ItemsRequest encode/decode round-trip (including Tag-24 path via DocRequest).
     */
    @TestCase
    func itemsRequestRoundTrip(): Unit {
        let rde = makeRde([("family_name", true), ("document_number", true)])
        let nsMap = HashMap<String, RequestDataElements>()
        nsMap["org.iso.18013.5.1"] = rde
        let rns = RequestNameSpaces(nsMap)
        let ir = ItemsRequest("org.iso.18013.5.1.mDL", rns, None)
        let cbor = ir.toCbor()
        let decoded = ItemsRequest.fromCbor(cbor)
        @Assert(decoded.docType == "org.iso.18013.5.1.mDL")
        @Assert(decoded.requestNameSpaces.nameSpaces.size == 1)
    }

    /*
     * done_when 1d: DocRequest with Tag-24 wrapped ItemsRequest round-trip.
     */
    @TestCase
    func docRequestTag24RoundTrip(): Unit {
        let rde = makeRde([("portrait", true)])
        let nsMap = HashMap<String, RequestDataElements>()
        nsMap["org.iso.18013.5.1"] = rde
        let rns = RequestNameSpaces(nsMap)
        let ir = ItemsRequest("org.iso.18013.5.1.mDL", rns, None)
        let dr = DocRequest(ir, None, None, None)
        let cbor = dr.toCbor()
        let decoded = DocRequest.fromCbor(cbor)
        @Assert(decoded.itemsRequest.docType == "org.iso.18013.5.1.mDL")
        match (decoded.readerAuth) {
            case None => @Assert(true)
            case Some(_) => @Assert(false)
        }
        // Verify Tag-24 is properly preserved in raw data
        match (decoded.itemsRequestRawData) {
            case Some(_) => @Assert(true)
            case None => @Assert(false)
        }
    }

    /*
     * done_when 1e (primary): DeviceRequest with ≥2 namespaces full CBOR round-trip.
     */
    @TestCase
    func deviceRequestTwoNamespacesRoundTrip(): Unit {
        // Namespace 1: ISO mDL namespace
        let rde1 = makeRde([
            ("family_name", true),
            ("document_number", true),
            ("portrait", false),
            ("age_over_18", true)
        ])
        // Namespace 2: AAMVA namespace
        let rde2 = makeRde([
            ("DHS_compliance", false),
            ("EDL_credential", true)
        ])
        let nsMap = HashMap<String, RequestDataElements>()
        nsMap["org.iso.18013.5.1"] = rde1
        nsMap["org.iso.18013.5.1.aamva"] = rde2
        let rns = RequestNameSpaces(nsMap)
        let ir = ItemsRequest("org.iso.18013.5.1.mDL", rns, None)
        let dr = DocRequest(ir, None, None, None)
        let deviceReq = DeviceRequest(
            DeviceRequest.VERSION_1_0,
            [dr],
            None,
            None
        )
        // Encode → bytes → decode
        let encoded = deviceReq.toBytes()
        let decoded = DeviceRequest.fromBytes(encoded)
        @Assert(decoded.version == DeviceRequest.VERSION_1_0)
        @Assert(decoded.docRequests.size == 1)
        let drDecoded = decoded.docRequests[0]
        @Assert(drDecoded.itemsRequest.docType == "org.iso.18013.5.1.mDL")
        @Assert(drDecoded.itemsRequest.requestNameSpaces.nameSpaces.size == 2)
        match (drDecoded.itemsRequest.requestNameSpaces.get("org.iso.18013.5.1")) {
            case Some(rdeDecoded) =>
                match (rdeDecoded.dataElements.get("family_name")) {
                    case Some(v) => @Assert(v == true)
                    case None => @Assert(false)
                }
                match (rdeDecoded.dataElements.get("portrait")) {
                    case Some(v) => @Assert(v == false)
                    case None => @Assert(false)
                }
            case None => @Assert(false)
        }
        match (drDecoded.itemsRequest.requestNameSpaces.get("org.iso.18013.5.1.aamva")) {
            case Some(rdeDecoded) =>
                match (rdeDecoded.dataElements.get("EDL_credential")) {
                    case Some(v) => @Assert(v == true)
                    case None => @Assert(false)
                }
            case None => @Assert(false)
        }
    }

    /*
     * done_when 1f: DeviceRequest with multiple DocRequests (two different docTypes).
     */
    @TestCase
    func deviceRequestMultipleDocRequests(): Unit {
        // First DocRequest: mDL
        let rde1 = makeRde([("family_name", true)])
        let nsMap1 = HashMap<String, RequestDataElements>()
        nsMap1["org.iso.18013.5.1"] = rde1
        let rns1 = RequestNameSpaces(nsMap1)
        let ir1 = ItemsRequest("org.iso.18013.5.1.mDL", rns1, None)
        let dr1 = DocRequest(ir1, None, None, None)
        // Second DocRequest: EU PID
        let rde2 = makeRde([("given_name", true), ("family_name", true)])
        let nsMap2 = HashMap<String, RequestDataElements>()
        nsMap2["eu.europa.ec.eudi.pid.1"] = rde2
        let rns2 = RequestNameSpaces(nsMap2)
        let ir2 = ItemsRequest("eu.europa.ec.eudi.pid.1", rns2, None)
        let dr2 = DocRequest(ir2, None, None, None)
        let deviceReq = DeviceRequest(DeviceRequest.VERSION_1_0, [dr1, dr2], None, None)
        let encoded = deviceReq.toBytes()
        let decoded = DeviceRequest.fromBytes(encoded)
        @Assert(decoded.docRequests.size == 2)
        @Assert(decoded.docRequests[0].itemsRequest.docType == "org.iso.18013.5.1.mDL")
        @Assert(decoded.docRequests[1].itemsRequest.docType == "eu.europa.ec.eudi.pid.1")
    }
}

/* ------------------------------------------------------------------ */
/* Test class — done_when 2: ReaderAuth container parsing              */
/* ------------------------------------------------------------------ */

@Test
public class ReaderAuthTest {

    /*
     * done_when 2a: ReaderAuth parses x5chain (single cert) from unprotected header.
     */
    @TestCase
    func readerAuthSingleCertParsing(): Unit {
        let cborArr = makeSyntheticReaderAuth()
        let readerAuth = ReaderAuth.fromCbor(cborArr)
        @Assert(readerAuth.x5chain.size == 1)
        @Assert(readerAuth.x5chain[0].size == 6)  // matches certBytes above
        // Verify COSE_Sign1 structure preserved
        match (readerAuth.coseSign1.payload) {
            case Some(b) => @Assert(b.size == 3)
            case None => @Assert(false)
        }
        @Assert(readerAuth.coseSign1.signature.size == 4)
    }

    /*
     * done_when 2b: ReaderAuth with array x5chain (multiple certs).
     */
    @TestCase
    func readerAuthMultiCertChain(): Unit {
        let cert1: Array<UInt8> = [0x30, 0x01, 0x02]
        let cert2: Array<UInt8> = [0x30, 0x03, 0x04, 0x05]
        // Build unprotected header with x5chain as array of bstr
        let certArr = ArrayList<CborValue>()
        certArr.add(CborValue.ByteStringVal(cert1))
        certArr.add(CborValue.ByteStringVal(cert2))
        let uphPairs = ArrayList<(CborValue, CborValue)>()
        uphPairs.add((CborValue.UInt64Val(33), CborValue.ArrayVal(certArr)))
        let uphMap = CborValue.MapVal(uphPairs)
        let uphBytes = uphMap.encode()
        let ph = CoseHeader.build(VerifyAlgorithm.Es256.coseValue(), true, None)
        let uphHeader = CoseHeader(None, None, Some(uphBytes))
        let sig: Array<UInt8> = [0x11, 0x22]
        let cose = CoseSign1(ph, Some(uphHeader), None, sig)
        let cborArr = cose.toCbor()
        let readerAuth = ReaderAuth.fromCbor(cborArr)
        @Assert(readerAuth.x5chain.size == 2)
        @Assert(readerAuth.x5chain[0].size == 3)
        @Assert(readerAuth.x5chain[1].size == 4)
    }

    /*
     * done_when 2c: ReaderAuth encode/decode round-trip via DocRequest.
     */
    @TestCase
    func readerAuthRoundTripViaDocRequest(): Unit {
        let raCbor = makeSyntheticReaderAuth()
        let rde = makeRde([("family_name", true)])
        let nsMap = HashMap<String, RequestDataElements>()
        nsMap["org.iso.18013.5.1"] = rde
        let rns = RequestNameSpaces(nsMap)
        let ir = ItemsRequest("org.iso.18013.5.1.mDL", rns, None)
        let readerAuth = ReaderAuth.fromCbor(raCbor)
        let dr = DocRequest(ir, None, Some(readerAuth), Some(raCbor))
        // Encode → bytes → decode via DeviceRequest
        let deviceReq = DeviceRequest(DeviceRequest.VERSION_1_0, [dr], None, None)
        let encoded = deviceReq.toBytes()
        let decoded = DeviceRequest.fromBytes(encoded)
        @Assert(decoded.docRequests.size == 1)
        match (decoded.docRequests[0].readerAuth) {
            case Some(ra) =>
                @Assert(ra.x5chain.size == 1)
            case None => @Assert(false)
        }
    }

    /*
     * done_when 2 (wire-format proof): Build a COSE_Sign1 array via encode() to get
     * raw CBOR bytes, then parse back via decodeCbor + ReaderAuth.fromCbor.
     *
     * This is the regression test for HI-MDOC-001: unprotected header is a
     * direct CBOR map (MapVal) in the wire array — NOT a bstr-wrapped map.
     * With the fix in cose.cj (CoseHeader.fromMap), fromCborArray correctly
     * populates CoseSign1.unprotectedHeader from MapVal, so ReaderAuth.fromCbor
     * can extract x5chain without throwing.
     */
    @TestCase
    func readerAuthWireFormatRoundTrip(): Unit {
        // 1. Build unprotected header map containing x5chain (label 33)
        let certBytes: Array<UInt8> = [0x30, 0x82, 0x02, 0x01, 0xAA, 0xBB, 0xCC]
        let uphPairs = ArrayList<(CborValue, CborValue)>()
        uphPairs.add((CborValue.UInt64Val(33), CborValue.ByteStringVal(certBytes)))
        let uphMap = CborValue.MapVal(uphPairs)

        // 2. Build protected header (alg = ES256 = -7)
        let ph = CoseHeader.build(VerifyAlgorithm.Es256.coseValue(), true, None)

        // 3. Assemble COSE_Sign1 array (untagged, per ISO 18013-5 §9.1.4 ReaderAuth)
        //    items = [bstr(protected_map), unprotected_map, payload_bstr, signature_bstr]
        let items = ArrayList<CborValue>()
        items.add(ph.toProtectedCbor())   // items[0]: bstr .cbor header_map
        items.add(uphMap)                  // items[1]: direct MapVal (wire-format unprotected header)
        items.add(CborValue.ByteStringVal([UInt8(0x01), UInt8(0x02)]))  // items[2]: payload
        items.add(CborValue.ByteStringVal([UInt8(0xDE), UInt8(0xAD), UInt8(0xBE), UInt8(0xEF)]))  // items[3]: signature
        let wireArray = CborValue.ArrayVal(items)

        // 4. Encode to bytes (simulate wire reception)
        let wireBytes = wireArray.encode()

        // 5. Decode from raw bytes — this is the exact path a real verifier takes
        let decoded: CborValue
        try {
            decoded = decodeCbor(wireBytes)
        } catch (e: Exception) {
            @Assert(false)
            return
        }

        // 6. Parse ReaderAuth — must NOT throw (this was the bug: unprotectedHeader=None)
        let readerAuth = ReaderAuth.fromCbor(decoded)

        // 7. Verify x5chain extracted correctly from unprotected header label 33
        @Assert(readerAuth.x5chain.size == 1)
        @Assert(readerAuth.x5chain[0].size == 7)
        @Assert(readerAuth.x5chain[0][0] == UInt8(0x30))
        @Assert(readerAuth.x5chain[0][6] == UInt8(0xCC))

        // 8. Verify COSE_Sign1 structure preserved
        @Assert(readerAuth.coseSign1.signature.size == 4)
        match (readerAuth.coseSign1.payload) {
            case Some(b) => @Assert(b.size == 2)
            case None => @Assert(false)
        }
    }

    /*
     * done_when 2d: DeviceRequestInfo (UseCase) round-trip.
     */
    @TestCase
    func deviceRequestInfoRoundTrip(): Unit {
        let docSets: Array<Array<UInt64>> = [[UInt64(0), UInt64(1)], [UInt64(2)]]
        let uc = UseCase(true, docSets, None)
        let dri = DeviceRequestInfo(Some([uc]))
        let cbor = dri.toCbor()
        let decoded = DeviceRequestInfo.fromCbor(cbor)
        match (decoded.useCases) {
            case Some(cases) =>
                @Assert(cases.size == 1)
                @Assert(cases[0].mandatory == true)
                @Assert(cases[0].documentSets.size == 2)
            case None => @Assert(false)
        }
    }
}

/* ------------------------------------------------------------------ */
/* Added coverage: RequestDataElements.elementIdentifiers,            */
/* ZkRequest round-trip, DocRequestInfo round-trip                    */
/* ------------------------------------------------------------------ */

@Test
public class RequestDataElementsIdentifiersTest {

    /* elementIdentifiers returns exactly the map keys. */
    @TestCase
    func elementIdentifiersReturnsKeys(): Unit {
        let rde = makeRde([("family_name", true), ("given_name", false), ("age", true)])
        let ids = rde.elementIdentifiers()
        @Assert(ids.size, Int64(3))
        var hasFamily = false
        var hasGiven = false
        var hasAge = false
        for (id in ids) {
            if (id == "family_name") { hasFamily = true }
            if (id == "given_name") { hasGiven = true }
            if (id == "age") { hasAge = true }
        }
        @Assert(hasFamily)
        @Assert(hasGiven)
        @Assert(hasAge)
    }
}

@Test
public class ZkRequestRoundTripTest {

    /* toCbor/fromCbor preserves the systemSpecs entries. */
    @TestCase
    func zkRequestRoundTrip(): Unit {
        let specs: Array<CborValue> = [
            CborValue.TextStringVal("spec-a"),
            CborValue.TextStringVal("spec-b")
        ]
        let zk = ZkRequest(specs)
        let cbor = zk.toCbor()
        let back = ZkRequest.fromCbor(decodeCbor(cbor.encode()))
        @Assert(back.systemSpecsRaw.size, Int64(2))
        match (back.systemSpecsRaw[0]) {
            case CborValue.TextStringVal(s) => @Assert(s, "spec-a")
            case _ => @Assert(false)
        }
    }
}

@Test
public class DocRequestInfoRoundTripTest {

    /* toCbor/fromCbor preserves scalar optional fields. */
    @TestCase
    func docRequestInfoScalarsRoundTrip(): Unit {
        let issuerIds: Array<Array<UInt8>> = [[0x01u8, 0x02u8], [0x03u8]]
        let info = DocRequestInfo(
            Some(issuerIds),
            Some(true),
            Some(UInt64(4096)),
            None,
            None
        )
        let cbor = info.toCbor()
        let back = DocRequestInfo.fromCbor(decodeCbor(cbor.encode()))

        match (back.uniqueDocSetRequired) {
            case Some(b) => @Assert(b)
            case None => @Assert(false)
        }
        match (back.maximumResponseSize) {
            case Some(n) => @Assert(n, UInt64(4096))
            case None => @Assert(false)
        }
        match (back.issuerIdentifiers) {
            case Some(ids) => @Assert(ids.size, Int64(2))
            case None => @Assert(false)
        }
    }

    /* An empty DocRequestInfo round-trips to all-None. */
    @TestCase
    func emptyDocRequestInfoRoundTrip(): Unit {
        let info = DocRequestInfo(None, None, None, None, None)
        let back = DocRequestInfo.fromCbor(decodeCbor(info.toCbor().encode()))
        @Assert(back.uniqueDocSetRequired.isNone())
        @Assert(back.maximumResponseSize.isNone())
        @Assert(back.issuerIdentifiers.isNone())
        @Assert(back.zkRequest.isNone())
    }
}
