        let oi = OriginInfoWebsite("https://wallet.example.eu", UInt64(1))
        let cbor = oi.toCbor()
        let decoded = OriginInfoWebsite.fromCbor(cbor)
        @Assert(decoded.baseUrl, "https://wallet.example.eu")
