/* Test helpers                                                        */
/* ------------------------------------------------------------------ */

func bytesEqualIA(a: Array<UInt8>, b: Array<UInt8>): Bool {
    if (a.size != b.size) {
        return false
    }
    var i = 0
    while (i < a.size) {
        if (a[i] != b[i]) {
            return false
        }
        i++
    }
    return true
}

/**
 * Build a minimal MobileSecurityObject with two namespaces, each with two
 * digests — used across multiple test cases.
 */
func buildTestMso(): MobileSecurityObject {
    // ValueDigests: two namespaces
    let ns1Digests = HashMap<UInt64, Array<UInt8>>()
    ns1Digests.add(UInt64(0), [0x11, 0x22, 0x33])
    ns1Digests.add(UInt64(1), [0x44, 0x55, 0x66])
    let ns2Digests = HashMap<UInt64, Array<UInt8>>()
    ns2Digests.add(UInt64(0), [0xAA, 0xBB])
    ns2Digests.add(UInt64(2), [0xCC, 0xDD, 0xEE, 0xFF])

    let vdMap = HashMap<String, DigestIDs>()
    vdMap.add("org.iso.18013.5.1", DigestIDs(ns1Digests))
    vdMap.add("org.iso.18013.5.1.aamva", DigestIDs(ns2Digests))
    let vd = ValueDigests(vdMap)

    // ValidityInfo
    let vi = ValidityInfo(
        "2024-01-01T00:00:00Z",
        "2024-01-01T00:00:00Z",
        "2025-01-01T00:00:00Z",
        None
    )

    // DeviceKeyInfo: minimal COSE_Key map with kty=2 (EC)
    let dkPairs = ArrayList<(CborValue, CborValue)>()
    dkPairs.add((CborValue.UInt64Val(1), CborValue.UInt64Val(2)))   // kty = EC2
    dkPairs.add((CborValue.NInt64Val(0), CborValue.UInt64Val(1)))   // crv = P-256
    let dkCbor = CborValue.MapVal(dkPairs)
    let dki = DeviceKeyInfo(dkCbor, None, None)

    return MobileSecurityObject(
        MobileSecurityObject.DEFAULT_VERSION,
        DigestAlgorithmKind.Sha256.stringValue(),
        vd,
        dki,
        "org.iso.18013.5.1.mDL",
        vi
    )
}

/* ================================================================== */
/* Test class 1 — done_when 1: MobileSecurityObject round-trip        */
/* ================================================================== */

@Test
public class MobileSecurityObjectTest {

    /**
     * Round-trip: encode MSO → CBOR map bytes → decode → field-by-field verify.
     * Covers: version, digestAlgorithm, docType.
     */
    @TestCase
    func msoScalarFieldsRoundTrip(): Unit {
        let mso = buildTestMso()
        let cbor = mso.toCbor()
        let bytes = cbor.encode()
        let back = decodeCbor(bytes)
        let decoded = MobileSecurityObject.fromCborMap(back)

        @Assert(decoded.version, MobileSecurityObject.DEFAULT_VERSION)
        @Assert(decoded.digestAlgorithm, DigestAlgorithmKind.Sha256.stringValue())
        @Assert(decoded.docType, "org.iso.18013.5.1.mDL")
    }

    /**
     * Round-trip: ValueDigests — multi-namespace, multi-digest verification.
     * Both namespaces and their digest entries must survive encode/decode.
     */
    @TestCase
    func msoValueDigestsMultiNamespaceRoundTrip(): Unit {
        let mso = buildTestMso()
        let cbor = mso.toCbor()
        let bytes = cbor.encode()
        let back = decodeCbor(bytes)
        let decoded = MobileSecurityObject.fromCborMap(back)

        let ns1Opt = decoded.valueDigests.get("org.iso.18013.5.1")
        match (ns1Opt) {
            case None => @Assert(false)
            case Some(ns1Ids) =>
                let d0Opt = ns1Ids.get(UInt64(0))
                match (d0Opt) {
                    case None => @Assert(false)
                    case Some(d0) => @Assert(bytesEqualIA(d0, [0x11, 0x22, 0x33]))
                }
                let d1Opt = ns1Ids.get(UInt64(1))
                match (d1Opt) {
                    case None => @Assert(false)
                    case Some(d1) => @Assert(bytesEqualIA(d1, [0x44, 0x55, 0x66]))
                }
        }

        let ns2Opt = decoded.valueDigests.get("org.iso.18013.5.1.aamva")
        match (ns2Opt) {
            case None => @Assert(false)
            case Some(ns2Ids) =>
                let d2Opt = ns2Ids.get(UInt64(2))
                match (d2Opt) {
                    case None => @Assert(false)
                    case Some(d2) => @Assert(bytesEqualIA(d2, [0xCC, 0xDD, 0xEE, 0xFF]))
                }
        }
    }

    /**
     * Round-trip: ValidityInfo — all three required timestamp fields survive.
     */
    @TestCase
    func msoValidityInfoRoundTrip(): Unit {
        let mso = buildTestMso()
        let cbor = mso.toCbor()
        let bytes = cbor.encode()
        let back = decodeCbor(bytes)
        let decoded = MobileSecurityObject.fromCborMap(back)

        @Assert(decoded.validityInfo.signed, "2024-01-01T00:00:00Z")
        @Assert(decoded.validityInfo.validFrom, "2024-01-01T00:00:00Z")
        @Assert(decoded.validityInfo.validUntil, "2025-01-01T00:00:00Z")
        match (decoded.validityInfo.expectedUpdate) {
            case None => @Assert(true)
            case Some(_) => @Assert(false)
        }
    }

    /**
     * Round-trip: ValidityInfo with optional expectedUpdate field.
     */
    @TestCase
    func msoValidityInfoWithExpectedUpdate(): Unit {
        let vi = ValidityInfo(
            "2024-01-01T00:00:00Z",
            "2024-01-01T00:00:00Z",
            "2025-01-01T00:00:00Z",
            Some("2024-07-01T00:00:00Z")
        )
        let cbor = vi.toCbor()
        let bytes = cbor.encode()
        let back = decodeCbor(bytes)
        let decoded = ValidityInfo.fromCbor(back)

        match (decoded.expectedUpdate) {
            case Some(eu) => @Assert(eu, "2024-07-01T00:00:00Z")
            case None => @Assert(false)
        }
    }

    /**
     * Round-trip: DeviceKeyInfo — deviceKey CborValue preserved through encode/decode.
     */
    @TestCase
    func msoDeviceKeyInfoRoundTrip(): Unit {
        let mso = buildTestMso()
        let cbor = mso.toCbor()
        let bytes = cbor.encode()
        let back = decodeCbor(bytes)
        let decoded = MobileSecurityObject.fromCborMap(back)

        match (decoded.deviceKeyInfo.deviceKey) {
            case CborValue.MapVal(pairs) =>
                @Assert(pairs.size > 0)
            case _ =>
                @Assert(false)
        }
    }

    /**
     * Tag-24 round-trip: encode as Tag-24 bytes, decode back via fromTag24Bytes.
     */
    @TestCase
    func msoTag24RoundTrip(): Unit {
        let mso = buildTestMso()
        let tag24Bytes = mso.toTag24Bytes()
        let decoded = MobileSecurityObject.fromTag24Bytes(tag24Bytes)

        @Assert(decoded.version, mso.version)
        @Assert(decoded.digestAlgorithm, mso.digestAlgorithm)
        @Assert(decoded.docType, mso.docType)
    }

    /**
     * Error case: fromCborMap with missing required field "version" throws.
     */
    @TestCase
    func msoMissingVersionThrows(): Unit {
        let pairs = ArrayList<(CborValue, CborValue)>()
        pairs.add((CborValue.TextStringVal("digestAlgorithm"), CborValue.TextStringVal("SHA-256")))
        let malformed = CborValue.MapVal(pairs)
        var threw = false
        try {
            let _ = MobileSecurityObject.fromCborMap(malformed)
        } catch (_: MdocValidationError) {
            threw = true
        }
        @Assert(threw)
    }
}

/* ================================================================== */
/* Test class 2 — done_when 2: IssuerAuth parse extracts MSO + sig    */
/* ================================================================== */

@Test
public class IssuerAuthTest {

    /**
     * Build a complete IssuerAuth from scratch, encode, then decode and
     * verify that the MSO and signature are correctly extracted.
     */
    @TestCase
    func issuerAuthRoundTripExtractsMsoAndSignature(): Unit {
        let mso = buildTestMso()
        let msoTag24Bytes = mso.toTag24Bytes()

        let fakeSig: Array<UInt8> = [0xDE, 0xAD, 0xBE, 0xEF, 0x01, 0x02, 0x03, 0x04]
        let fakeCert: Array<UInt8> = [0x30, 0x82, 0x01, 0x00]

        let x5chainList = ArrayList<Array<UInt8>>()
        x5chainList.add(fakeCert)

        let ia = IssuerAuth(
            mso,
            msoTag24Bytes,
            VerifyAlgorithm.Es256.coseValue(),
            fakeSig,
            x5chainList,
            None
        )

        let taggedCbor = ia.toCbor()
        let decoded = IssuerAuth.fromCbor(taggedCbor)

        // Verify MSO docType survived the round-trip
        @Assert(decoded.mso.docType, "org.iso.18013.5.1.mDL")
        // Verify msoRawData == original msoTag24Bytes
        @Assert(bytesEqualIA(decoded.msoRawData, msoTag24Bytes))
        // Verify signature preserved
        @Assert(bytesEqualIA(decoded.signature, fakeSig))
        // Verify algorithm
        @Assert(decoded.verifyAlgorithm, VerifyAlgorithm.Es256.coseValue())
    }

    /**
     * Verify x5chain with a single certificate encodes/decodes correctly.
     */
    @TestCase
    func issuerAuthSingleCertX5Chain(): Unit {
        let mso = buildTestMso()
        let msoBytes = mso.toTag24Bytes()
        let fakeSig: Array<UInt8> = [0xFF]
        let fakeCert: Array<UInt8> = [0x30, 0x81, 0x02]

        let x5chainList = ArrayList<Array<UInt8>>()
        x5chainList.add(fakeCert)

        let ia = IssuerAuth(mso, msoBytes, VerifyAlgorithm.Es256.coseValue(), fakeSig, x5chainList, None)
        let decoded = IssuerAuth.fromCbor(ia.toCbor())

        @Assert(decoded.x5chain.size, Int64(1))
        @Assert(bytesEqualIA(decoded.x5chain[0], fakeCert))
    }

    /**
     * Verify x5chain with multiple certificates (array form) encodes/decodes correctly.
     */
    @TestCase
    func issuerAuthMultiCertX5Chain(): Unit {
        let mso = buildTestMso()
        let msoBytes = mso.toTag24Bytes()
        let fakeSig: Array<UInt8> = [0x01]
        let cert1: Array<UInt8> = [0x30, 0x01]
        let cert2: Array<UInt8> = [0x30, 0x02]
        let cert3: Array<UInt8> = [0x30, 0x03]

        let x5chainList = ArrayList<Array<UInt8>>()
        x5chainList.add(cert1)
        x5chainList.add(cert2)
        x5chainList.add(cert3)

        let ia = IssuerAuth(mso, msoBytes, VerifyAlgorithm.Es256.coseValue(), fakeSig, x5chainList, None)
        let decoded = IssuerAuth.fromCbor(ia.toCbor())

        @Assert(decoded.x5chain.size, Int64(3))
        @Assert(bytesEqualIA(decoded.x5chain[0], cert1))
        @Assert(bytesEqualIA(decoded.x5chain[1], cert2))
        @Assert(bytesEqualIA(decoded.x5chain[2], cert3))
    }

    /**
     * Verify that ValueDigests survive IssuerAuth round-trip including
     * multi-namespace multi-digest verification.
     */
    @TestCase
    func issuerAuthValueDigestsPreservedInMso(): Unit {
        let mso = buildTestMso()
        let msoBytes = mso.toTag24Bytes()
        let fakeSig: Array<UInt8> = [0xAB]
        let fakeCert: Array<UInt8> = [0x30]

        let x5chainList = ArrayList<Array<UInt8>>()
        x5chainList.add(fakeCert)

        let ia = IssuerAuth(mso, msoBytes, VerifyAlgorithm.Es256.coseValue(), fakeSig, x5chainList, None)
        let decoded = IssuerAuth.fromCbor(ia.toCbor())

        let ns1Opt = decoded.mso.valueDigests.get("org.iso.18013.5.1")
        match (ns1Opt) {
            case None => @Assert(false)
            case Some(ns1Ids) =>
                let d0Opt = ns1Ids.get(UInt64(0))
                match (d0Opt) {
                    case None => @Assert(false)
                    case Some(d0) => @Assert(bytesEqualIA(d0, [0x11, 0x22, 0x33]))
                }
        }
        let ns2Opt = decoded.mso.valueDigests.get("org.iso.18013.5.1.aamva")
        match (ns2Opt) {
            case None => @Assert(false)
            case Some(ns2Ids) =>
                let d2Opt = ns2Ids.get(UInt64(2))
                match (d2Opt) {
                    case None => @Assert(false)
                    case Some(d2) => @Assert(bytesEqualIA(d2, [0xCC, 0xDD, 0xEE, 0xFF]))
                }
        }
    }

    /**
     * Error case: IssuerAuth.fromCbor with non-tag-18 CBOR throws.
     */
    @TestCase
    func issuerAuthInvalidTagThrows(): Unit {
        let notACose = CborValue.TextStringVal("not a COSE_Sign1")
        var threw = false
        try {
            let _ = IssuerAuth.fromCbor(notACose)
        } catch (_: MdocValidationError) {
            threw = true
        }
        @Assert(threw)
    }

    /**
     * Wire-format proof: construct tag-18 COSE_Sign1 manually
     * (items[1] is a raw MapVal {33: bstr(cert)}, NOT going through IssuerAuth.toCbor),
     * verify that IssuerAuth.fromCbor correctly extracts MSO, signature, and x5chain.
     *
     * This test specifically validates the HI-MDOC-001 fix: CoseSign1.fromCborArray
     * now calls CoseHeader.fromMap(items[1]) instead of fromBytestring(items[1]),
     * so the unprotected header is no longer None and x5chain extraction succeeds.
     *
     * Wire-format COSE_Sign1 (RFC 8152 §4.2):
     *   #6.18([
     *     protected   : bstr .cbor {1: -7},   // ES256 algorithm
     *     unprotected : {33: bstr(cert)},      // x5chain as direct MapVal
     *     payload     : bstr(Tag24-wrapped MSO),
     *     signature   : bstr
     *   ])
     */
    @TestCase
    func issuerAuthWireFormatParsesCorrectly(): Unit {
        let mso = buildTestMso()
        let msoTag24Bytes = mso.toTag24Bytes()

        let fakeSig: Array<UInt8> = [0xCA, 0xFE, 0xBA, 0xBE, 0x05, 0x06, 0x07, 0x08]
        let fakeCert: Array<UInt8> = [0x30, 0x82, 0x02, 0x00, 0x01, 0x02]

        // Build protected header bstr: {1: -7} (alg = ES256, COSE value -7)
        // NInt64Val(n) encodes as -(1+n), so for -7 we need NInt64Val(6)
        let phPairs = ArrayList<(CborValue, CborValue)>()
        phPairs.add((CborValue.UInt64Val(UInt64(1)), CborValue.NInt64Val(UInt64(6))))
        let phMapBytes = CborValue.MapVal(phPairs).encode()
        let protectedItem = CborValue.ByteStringVal(phMapBytes)

        // Build unprotected header as a direct MapVal {33: bstr(cert)} — wire format
        let uphPairs = ArrayList<(CborValue, CborValue)>()
        uphPairs.add((CborValue.UInt64Val(UInt64(33)), CborValue.ByteStringVal(fakeCert)))
        let unprotectedItem = CborValue.MapVal(uphPairs)

        // Build COSE_Sign1 array and wrap with tag 18
        let coseItems = ArrayList<CborValue>()
        coseItems.add(protectedItem)
        coseItems.add(unprotectedItem)
        coseItems.add(CborValue.ByteStringVal(msoTag24Bytes))
        coseItems.add(CborValue.ByteStringVal(fakeSig))
        let wireFormat = CborValue.TaggedVal(CborTag.COSE_SIGN1, CborValue.ArrayVal(coseItems))

        // Parse via IssuerAuth.fromCbor — must not throw (HI-MDOC-001 fix)
        let decoded = IssuerAuth.fromCbor(wireFormat)

        // Assert MSO docType survived
        @Assert(decoded.mso.docType, "org.iso.18013.5.1.mDL")
        // Assert msoRawData == original Tag24 bytes
        @Assert(bytesEqualIA(decoded.msoRawData, msoTag24Bytes))
        // Assert signature preserved
        @Assert(bytesEqualIA(decoded.signature, fakeSig))
        // Assert algorithm = ES256 = -7
        @Assert(decoded.verifyAlgorithm, VerifyAlgorithm.Es256.coseValue())
        // Assert x5chain extracted correctly (single cert)
        @Assert(decoded.x5chain.size, Int64(1))
        @Assert(bytesEqualIA(decoded.x5chain[0], fakeCert))
    }
}

/* ================================================================== */
/* Test class 3 — DigestAlgorithmKind helper                          */
/* ================================================================== */

@Test
public class DigestAlgorithmKindTest {

    @TestCase
    func sha256StringValue(): Unit {
        @Assert(DigestAlgorithmKind.Sha256.stringValue(), "SHA-256")
    }

    @TestCase
    func sha384StringValue(): Unit {
        @Assert(DigestAlgorithmKind.Sha384.stringValue(), "SHA-384")
    }

    @TestCase
    func sha512StringValue(): Unit {
        @Assert(DigestAlgorithmKind.Sha512.stringValue(), "SHA-512")
    }

    @TestCase
    func fromStringRoundTrip(): Unit {
        let kind = DigestAlgorithmKind.fromString("SHA-256")
        match (kind) {
            case Some(DigestAlgorithmKind.Sha256) => @Assert(true)
            case _ => @Assert(false)
        }
    }

    @TestCase
    func fromStringUnknownReturnsNone(): Unit {
        let kind = DigestAlgorithmKind.fromString("MD5")
        match (kind) {
            case None => @Assert(true)
            case Some(_) => @Assert(false)
        }
    }
}

/* ================================================================== */
/* Added coverage: MobileSecurityObject.toTag24Cbor,                  */
/* StatusIdentifier.fromMsoCbor                                        */
/* ================================================================== */

@Test
public class MsoToTag24CborTest {

    /* toTag24Cbor produces Tag-24 bytes that decode back to an equal MSO. */
    @TestCase
    func toTag24CborRoundTrip(): Unit {
        let mso = buildTestMso()
        let tag24 = mso.toTag24Cbor()
        let bytes = tag24.encode()
        let decoded = MobileSecurityObject.fromTag24Bytes(bytes)

        @Assert(decoded.version, MobileSecurityObject.DEFAULT_VERSION)
        @Assert(decoded.docType, "org.iso.18013.5.1.mDL")
        @Assert(decoded.digestAlgorithm, DigestAlgorithmKind.Sha256.stringValue())
    }

    /* The Tag-24 wrapper is a tagged CBOR value (not a bare map). */
    @TestCase
    func toTag24CborIsTagged(): Unit {
        let mso = buildTestMso()
        let tag24 = mso.toTag24Cbor()
        match (tag24) {
            case CborValue.TaggedVal(tag, _) => @Assert(tag, CborTag.ENCODED_CBOR)
            case _ => @Assert(false)
        }
    }
}

@Test
public class StatusIdentifierFromMsoCborTest {

    /* fromMsoCbor extracts idx + uri from a nested status/status_list map. */
    @TestCase
    func fromMsoCborExtractsStatus(): Unit {
        let statusListPairs = ArrayList<(CborValue, CborValue)>()
        statusListPairs.add((CborValue.TextStringVal("idx"), CborValue.UInt64Val(UInt64(42))))
        statusListPairs.add((CborValue.TextStringVal("uri"), CborValue.TextStringVal("https://status.example/list")))
        let statusPairs = ArrayList<(CborValue, CborValue)>()
        statusPairs.add((CborValue.TextStringVal("status_list"), CborValue.MapVal(statusListPairs)))
        let msoPairs = ArrayList<(CborValue, CborValue)>()
        msoPairs.add((CborValue.TextStringVal("status"), CborValue.MapVal(statusPairs)))
        let msoCbor = CborValue.MapVal(msoPairs)

        match (StatusIdentifier.fromMsoCbor(msoCbor)) {
            case Some(si) =>
                @Assert(si.idx, Int64(42))
                @Assert(si.uriString, "https://status.example/list")
            case None => @Assert(false)
        }
    }

    /* fromMsoCbor returns None when the status field is absent. */
    @TestCase
    func fromMsoCborNoneWhenAbsent(): Unit {
        let msoPairs = ArrayList<(CborValue, CborValue)>()
        msoPairs.add((CborValue.TextStringVal("version"), CborValue.TextStringVal("1.0")))
        let msoCbor = CborValue.MapVal(msoPairs)
        @Assert(StatusIdentifier.fromMsoCbor(msoCbor).isNone())
    }
}
